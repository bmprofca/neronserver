{
  "name": "neron-server",
  "version": "1.0.0",
  "private": true,
  "description": "Neron API server",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "agent": "node agent/index.js",
    "agent:build-exe": "pkg agent/index.js --targets node18-win-x64 --output agent/dist/NeronLanAgent.exe --compress GZip",
    "test": "node scripts/test-mqtt-unit.js",
    "mqtt:simulate-neron": "node scripts/mqtt-simulate-neron.js",
    "mqtt:test-connection": "node scripts/mqtt-test-connection.js"
  },
  "bin": {
    "neron-lan-agent": "agent/index.js"
  },
  "pkg": {
    "assets": [
      "src/neronClient.js"
    ],
    "scripts": [
      "src/neronClient.js"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.15.2",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "pkg": "^5.8.1"
  }
}
